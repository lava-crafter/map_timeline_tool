<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Photos are excluded from cloud backup: past the 25 MB quota Android drops the whole app backup,
         database included. Use the in-app ZIP backup for photos. Device-local prefs never leave the device. -->
    <cloud-backup>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="location_cache.xml"/>
        <exclude domain="sharedpref" path="map_timeline_device.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="location_cache.xml"/>
        <exclude domain="sharedpref" path="map_timeline_device.xml"/>
        <include domain="file" path="point_photos/"/>
    </device-transfer>
</data-extraction-rules>
