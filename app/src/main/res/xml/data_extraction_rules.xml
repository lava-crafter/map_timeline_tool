<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="quick_add_device_state.xml"/>
        <include domain="file" path="point_photos/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="quick_add_device_state.xml"/>
        <include domain="file" path="point_photos/"/>
    </device-transfer>
</data-extraction-rules>
